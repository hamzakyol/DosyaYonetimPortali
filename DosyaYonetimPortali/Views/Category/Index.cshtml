@model IEnumerable<DosyaYonetimPortali.Models.Entities.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container mt-4">
    <h2 class="mb-4">Kategori Yönetim Paneli</h2>

    <!-- Kategori Ekleme Formu -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Yeni Kategori Ekle
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="row g-3">
                <div class="col-md-9">
                    <input type="text" name="name" class="form-control" placeholder="Kategori Adı Giriniz (Örn: Sınav Notları)" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success w-100">+ Kategori Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Kategori Listesi -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            Mevcut Kategoriler
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th># ID</th>
                        <th>Kategori Adı</th>
                        <th>Oluşturulma Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">Henüz hiç kategori eklenmemiş.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>@cat.Id</td>
                                <td><strong>@cat.Name</strong></td>
                                <td>@cat.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Delete" asp-route-id="@cat.Id" onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>