@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold">Giriş Yap</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mb-3">@ViewBag.Error</div>
                }
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-posta</label>
                        <input type="email" name="email" class="form-control" placeholder="E-posta adresiniz" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Şifre</label>
                        <input type="password" name="password" class="form-control" placeholder="Şifreniz" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Giriş Yap</button>
                </form>
            </div>
        </div>
    </div>
</div>