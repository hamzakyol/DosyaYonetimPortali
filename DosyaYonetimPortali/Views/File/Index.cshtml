@model IEnumerable<DosyaYonetimPortali.Models.Entities.FileItem>

@{
    ViewData["Title"] = "Dosyalarım";
    var categories = ViewBag.Categories as IEnumerable<DosyaYonetimPortali.Models.Entities.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark m-0"><i class="bi bi-folder2-open text-primary me-2"></i>Dosya Yönetimi</h2>
    <a asp-action="Upload" class="btn btn-primary px-4 shadow-sm fw-semibold">
        <i class="bi bi-cloud-upload me-2"></i>Yeni Dosya Yükle
    </a>
</div>

<!-- Arama ve Filtreleme Kartı -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Dosya adı ile ara..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.SelectedCategory == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Dosya Tablosu Kartı -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Dosya Adı</th>
                        <th>Boyut</th>
                        <th>Yüklenme Tarihi</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Henüz yüklenmiş bir dosya bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var file in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <i class="bi bi-file-earmark-text text-primary fs-5 me-2"></i>
                                    <span class="fw-semibold">@file.FileName</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@((file.FileSize / 1024.0).ToString("F2")) KB</span></td>
                                <td>@file.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a href="@file.FilePath" download class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-download"></i> İndir
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@file.Id" onclick="return confirm('Bu dosyayı silmek istediğinizden emin misiniz?');" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>